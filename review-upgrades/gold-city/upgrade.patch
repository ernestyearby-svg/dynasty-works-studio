+.upgrade-concept-label { display:inline-block; font-size:10px; font-weight:600; letter-spacing:.07em; border-bottom:1px solid #777166; padding-bottom:7px; }
+.upgrade-study figcaption p:not(.eyebrow) { font-size:15px; line-height:1.75; margin-top:15px; }
