+.upgrade-output ul { list-style:none; margin:0; padding:0; }
+.upgrade-output li { font-size:14px; line-height:1.8; padding-bottom:8px; }
+.upgrade-method-stage details { border-top:1px solid #c7c2b9; padding-top:20px; }
+.upgrade-method-stage summary { display:flex; justify-content:space-between; cursor:pointer; font-size:13px; padding:10px 0; list-style:none; min-height:44px; }
+.upgrade-method-stage summary::-webkit-details-marker { display:none; }
+.upgrade-method-stage details > ul { padding-left:18px; font-size:14px; line-height:1.9; margin:25px 0; }
+.upgrade-method-stage details[open] summary span { transform:rotate(45deg); }
+.upgrade-practice-links { display:flex; flex-wrap:wrap; gap:25px; margin:20px 0; text-transform:capitalize; font-size:13px; }
+.upgrade-example-link { padding-block:100px; border-top:1px solid #c7c2b9; }
+.upgrade-example-link h2 { margin:25px 0 30px; }
