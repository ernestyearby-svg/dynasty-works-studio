+ .upgrade-study figcaption { grid-template-columns:1fr; gap:25px; padding:25px 24px 0; }
+ .upgrade-study h2 { max-width:19ch; font-size:40px; }
+ .upgrade-study-nav { gap:25px; }
+}
+@media(prefers-reduced-motion:reduce) { .upgrade-paths b { transition:none; } }
