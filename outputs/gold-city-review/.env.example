# Public canonical origin; never place secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=https://dynasty-works-studio.ernestyearby.chatgpt.site
# Keep false until portfolio content is approved and the site is public.
INDEXING_ENABLED=false
# Inquiry backend is deliberately absent. See README before enabling delivery.

# Future Supabase configuration — intentionally blank; not read to activate V1.4.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only settings. Never rename these with NEXT_PUBLIC_. No real secrets belong here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
INQUIRY_SUBMISSIONS_ENABLED=false
# Future approved distributed limiter and bot-verification providers; blank until selected.
INQUIRY_RATE_LIMIT_URL=
INQUIRY_RATE_LIMIT_TOKEN=
INQUIRY_BOT_SECRET=
# Future private bucket name; uploads remain disabled.
SUPABASE_PRIVATE_INTAKE_BUCKET=
